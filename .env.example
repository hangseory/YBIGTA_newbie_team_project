# RDS 접속 정보 (기존 앱 + collector 공용)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=reviewdb

# 기존 FastAPI 앱(users)이 사용하는 계정
MYSQL_USER=
MYSQL_PASSWORD=

# collector 전용 계정 (schema.sql에서 생성하는 collector_user, read/write 전용)
COLLECTOR_DB_USER=collector_user
COLLECTOR_DB_PASSWORD=

# 아래는 MCP / Agent 담당 팀원이 채울 항목 (참고용)
# MCP_AUTH_TOKEN=
# ANTHROPIC_API_KEY=
